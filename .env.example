# Copy to .env and fill in (never commit .env — _local/ is gitignored)
#
# NOTION_TOKEN=ntn_... or secret_...  (from notion.so/my-integrations)
#
# Parent page: create "AI Systems Engineer 2027" in Notion → ⋯ → Connections → add integration
# Copy from URL — use the 32-char hex at the end (slug is OK; script strips it):
# https://www.notion.so/AISystemEngineer-3dae37de74b2803fb23bce6021686320?v=...
# NOTION_PARENT_PAGE_ID=3dae37de74b2803fb23bce6021686320
# or paste full slug+id; sync_notion.py keeps the last 32 hex digits.
# Optional overrides if you already have database IDs:
# NOTION_LESSONS_DB_ID=
# NOTION_PROGRESS_DB_ID=
