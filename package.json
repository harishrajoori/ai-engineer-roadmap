{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src scripts",
    "preview": "vite preview",
    "curriculum": "python3 scripts/merge_topic_handbook.py && python3 scripts/generate_lessons.py",
    "validate:app": "node scripts/validate_app.mjs",
    "validate:models": "node scripts/validate_ai_models.mjs",
    "validate:links": "python3 scripts/validate_curriculum.py",
    "validate": "npm run validate:app && npm run validate:links",
    "test:prove": "node scripts/test_prove_workflow.mjs",
    "validate:repos": "python3 scripts/github_repo_validate.py --check",
    "validate:ci": "npm run validate:app && npm run validate:models && npm run test:prove && npm run validate:repos && python3 scripts/validate_curriculum.py --skip-http && python3 scripts/audit_public_content.py",
    "audit:public": "python3 scripts/audit_public_content.py"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "canvas-confetti": "^1.9.4",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.45.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
